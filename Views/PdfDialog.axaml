<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GeneradorVoucher_MP.PdfDialog"
        Title="PDF Creado"
        Width="400" Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="BorderOnly"
        SizeToContent="WidthAndHeight"> 
    
    <Border Padding="20" Background="#F9F9F9">
        <StackPanel Spacing="15" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Name="LblMensaje" 
                           Text="¡PDF generado con éxito!&#x0a;&#x0a;¿Desea abrir el archivo ahora?" 
                           TextWrapping="Wrap" 
                           FontSize="14" 
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                <Button Name="BtnSi" Content="Sí, abrir" Width="100" 
                        HorizontalContentAlignment="Center" Click="BtnSi_Click"
                        Background="#2196F3" Foreground="White" HotKey="Enter"/>
                
                <Button Name="BtnNo" Content="No" Width="100" 
                        HorizontalContentAlignment="Center" Click="BtnNo_Click"
                        Background="#E0E0E0" HotKey="Escape"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>