<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="GeneradorVoucher_MP.Views.PasswordWindow"
        Title=""
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent">

    <Panel>


        <!-- Tarjeta centrada -->
        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="12"
                Width="360"
                >

            <StackPanel Spacing="0">

                <!-- Encabezado azul -->
                <Border Background="#1F4E78"
                        CornerRadius="12,12,0,0"
                        Padding="24,20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Generador Voucher"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Caminandes · San Pedro de Atacama"
                                   FontSize="11"
                                   Foreground="#AAC8E8" />
                    </StackPanel>
                </Border>

                <!-- Cuerpo -->
                <StackPanel Spacing="16" Margin="24,20">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Contraseña de base de datos"
                                   FontSize="11"
                                   Foreground="#666666" />

                            <TextBox Name="txtPassword"
                                     PasswordChar="●"
                                     PlaceholderText="Ingrese la contraseña..."
                                     CornerRadius="6,6,6,6"
                                     BorderThickness="1,1,1,1" />

                    </StackPanel>

                    <!-- Mensaje de error -->
                    <Border Name="panelError"
                            Background="#FEE2E2"
                            CornerRadius="6"
                            Padding="10,8"
                            IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Name="lblError"
                                       FontSize="11"
                                       Foreground="#991B1B"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Botón ingresar -->
                    <Button Name="btnIngresar"
                            Content="Ingresar al sistema"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Height="38"
                            Background="#1F4E78"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="6"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Click="btnIngresar_Click">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#163A5F" />
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="#0D2A45" />
                            </Style>
                        </Button.Styles>
                    </Button>

                </StackPanel>

            </StackPanel>
        </Border>
    </Panel>
</Window>