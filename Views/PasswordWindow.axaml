<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GeneradorVoucher_MP.Views.PasswordWindow"
        Title="PasswordWindow">
  <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Ingresar Contraseña" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Ingrese la contraseña de la base de datos para iniciar:" FontSize="11" TextWrapping="Wrap" Foreground="Gray"/>

        <TextBox Name="txtPassword" PasswordChar="*" PlaceholderText="Contraseña..."/>

        <TextBlock Name="lblError" Foreground="Red" FontSize="11" IsVisible="False" HorizontalAlignment="Center"/>

        <Button Name="btnIngresar" Content="Ingresar" HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Center" Click="btnIngresar_Click" Margin="0,5,0,0"/>
    </StackPanel>
</Window>
