<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GeneradorVoucher_MP.PagInicio">

    <Panel>

        <!-- Fondo -->
        <Image Source="avares://GeneradorVoucher_MP/Assets/fondo_inicio.jpg"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- Capa oscura para legibilidad -->
        <Border Background="#60000000" />

        <!-- Contenido -->
        <Grid RowDefinitions="*, Auto">

            <!-- Logo centrado verticalmente en el espacio superior -->
            <Image Grid.Row="0"
                   Source="avares://GeneradorVoucher_MP/Assets/logo_caminandes_2.png"
                   Stretch="Uniform"
                   MaxHeight="300"
                   MaxWidth="600"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Barra inferior: usuario izquierda, botón derecha -->
            <Border Grid.Row="1"
                    Padding="40,60">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- IZQUIERDA: usuario e idioma -->
                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                Spacing="12"
                                VerticalAlignment="Center">

                        <!-- Selector de usuario -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Usuario"
                                       FontSize="13"
                                       Foreground="White"
                                       VerticalAlignment="Center" />

                            <AutoCompleteBox Name="cmbSelectUsuario"
                                             Width="220"
                                             MinimumPrefixLength="1"
                                             IsTabStop="True"
                                             Background="#CCFFFFFF"
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- DERECHA: botón -->
                    <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="6"
                            Padding="0">                     

                        <Button Name="btnPagCliente"
                                Height="40"
                                Background="#1F4E78"
                                Foreground="White"
                                BorderThickness="0"
                                Click="btnPagCliente_Click"
                                Padding="18,0"
                                CornerRadius="6">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#163A5F" />
                                </Style>
                                <Style Selector="Button:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#0D2A45" />
                                </Style>
                            </Button.Styles>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Iniciar nueva aventura"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                <PathIcon Data="{StaticResource airplane_regular}"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Panel>

</UserControl>